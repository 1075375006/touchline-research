{
  "data": {
    "mechanisms": [
      {
        "name": "赛制与积分推演",
        "chain": "先列积分、净胜球、相互战绩和剩余赛程，再分情形计算容错与出线条件；结论可为某队占优，也可停在条件推演。",
        "when": "小组赛形势、晋级路径或末轮动力分析。",
        "counterHandling": "把他队赛果、规则条件标为假设，列出不同结果分支；不把单场胜负等同最终出线。",
        "ids": [
          "chengzi-d82797dd0441",
          "chengzi-2c f3b7e900a",
          "chengzi-09aab3f4d74e",
          "chengzi-fc9187ef7537"
        ]
      },
      {
        "name": "材料—中间判断—方向",
        "chain": "以战绩、阵容、伤停、交锋或赛程为输入，经由状态、战术匹配或体能判断，落到胜负倾向或风险提示。",
        "when": "赛前单场分析；需明确每项材料如何影响比赛，而非只堆数据。",
        "counterHandling": "补充对手优势或反向变量，区分事实、传闻与推测；资料不足时保留倾向，不强行给确定结论。",
        "ids": [
          "chengzi-7b45f1ccec2d",
          "chengzi-fae577f8b4fb",
          "chengzi-9901c4b37bff",
          "chengzi-02e192f819a5"
        ]
      },
      {
        "name": "战术处方与对位推演",
        "chain": "指出对手特点和本方短板，再提出打法选择，推演其可能创造的机会或限制；可止于战术建议，不必预测赛果。",
        "when": "赛前支招、弱队应对强队或赛后讨论打法。",
        "counterHandling": "把战术方案写成条件性判断，说明执行能力及对手反制，不以别队爆冷直接证明方案有效。",
        "ids": [
          "chengzi-25bf1219dd98",
          "chengzi-60179f3dd610",
          "chengzi-39e97a6be474",
          "chengzi-9961d296d1bb"
        ]
      },
      {
        "name": "关键节点复盘",
        "chain": "按比赛进程选取换人、进球、判罚或战术变化，说明局势如何改变，再归因或提出后续问题。",
        "when": "赛后复盘；时间轴叙述与单点归因应区分。",
        "counterHandling": "交代其他可能因素，避免用一个节点解释全部结果，也不以后见之明包装赛前判断。",
        "ids": [
          "chengzi-a2c190097720",
          "chengzi-36f5a4d8ae63",
          "chengzi-cc68f2e22ee1"
        ]
      },
      {
        "name": "动力与赛程变量",
        "chain": "从积分任务、赛程密度或出线处境推测比赛动力，再讨论其对策略和比赛强度的影响。",
        "when": "强弱对阵之外，比赛目标可能改变选择时。",
        "counterHandling": "动力是推测而非结果保证；同时考察轮换、能力差异及临场执行。",
        "ids": [
